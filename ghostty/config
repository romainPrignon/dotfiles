maximize = true
copy-on-select = false
keybind = ctrl+t=new_tab
keybind = ctrl+n=new_window
keybind = ctrl+v=copy_to_clipboard
keybind = ctrl+b=paste_from_clipboard
keybind = alt+arrow_left=previous_tab
keybind = alt+arrow_right=next_tab
keybind = ctrl+w=close_tab
keybind = alt+q=close_window
gtk-titlebar = false
cursor-style = bar
font-family = Ubuntu Mono Medium
font-size = 11.5
window-padding-x = 20
theme = dark:myMonokai,light:myMonokai
